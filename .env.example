# Copy to .env.local and fill in. Every service below is used on its FREE plan only.

# Groq free tier (https://console.groq.com/keys), primary model
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio free tier (https://aistudio.google.com/apikey), fallback model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional 100% local run with Ollama (https://ollama.com), no key needed
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Fallback order
LLM_PROVIDERS=groq,gemini,ollama

# Tavily free plan (https://app.tavily.com), 1,000 searches/month. Optional:
# without it the agent searches Hacker News only.
TAVILY_API_KEY=
